# Copie para .env (ou exporte no terminal) para testar as fontes opcionais localmente.
# No GitHub, cadastre estes valores em Settings → Secrets and variables → Actions.

# Twitch (audiência ao vivo) + IGDB (jogos mais aguardados): https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube Data API v3 (vídeos de games em alta): https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Limite de buscas de capas na Steam por execução (o resultado fica em cache)
# MAX_IMAGE_LOOKUPS=90
